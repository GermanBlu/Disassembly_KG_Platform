# ── Neo4j ──────────────────────────────────────────────────────────
# Local Neo4j Desktop:   bolt://localhost:7687
# Neo4j AuraDB (cloud):  neo4j+s://<instance>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Default model of config.py. The evaluation of the paper used
# OPENAI_MODEL=gpt-6-luna; set that value to reproduce it.
OPENAI_MODEL=gpt-5.4-mini

# ── Server ────────────────────────────────────────────────────────
PORT=5050

# Bind address. Default is localhost-only — set to 0.0.0.0 ONLY if you
# intentionally want to expose the service on the network.
FLASK_HOST=127.0.0.1

# Werkzeug debug console (RCE vector). OFF by default. Set to 1 only in
# local development — NEVER in anything network-reachable.
FLASK_DEBUG=0

# Max upload size in MB. Requests larger than this get a clean 413 JSON
# error before they reach any handler.
MAX_UPLOAD_MB=50

# Admin token gating destructive endpoints (currently /api/library/reset).
# Leave unset to keep the endpoint disabled — the safer default.
# If set, callers must send: X-Admin-Token: <value>
ADMIN_TOKEN=

# Python logging level. DEBUG shows Cypher generation internals, INFO is
# normal. Warning and above for production.
LOG_LEVEL=INFO

